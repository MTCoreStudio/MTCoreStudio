# Block directory listing
Options -Indexes

<IfModule mod_authz_core.c>
  # Apache 2.4 — block direct web access to the config file (server-side
  # includes still work; only HTTP requests to it are denied).
  <FilesMatch "^(config\.php)$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<FilesMatch "\.(log|json|md)$|^\.(visit-secret|rate-limit|login-attempts)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
