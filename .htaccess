# ---------------------------------------------------------------------------
# MT Core Studio - site root Apache config (InfinityFree safe)
# ---------------------------------------------------------------------------

# Never list directory contents.
Options -Indexes

# Use the site's own accessible not-found page for unknown URLs.
ErrorDocument 404 /404.html

# Keep the server-managed data files out of direct browser reach.
# These files are read/written by PHP (api/ and admin/) and are never
# needed by the public pages, so their contents stay private.
<FilesMatch "^(visits|waitlist)\.js$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Hidden files (e.g. the rate-limit log) must never be downloadable.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Project/config text files are not meant for browsers either.
<FilesMatch "\.(md|json|lock|log|sql|env(\.sample)?)$|^(README|LICENSE|package|composer|pnpm-lock|yarn|package-lock|vite\.config|tsconfig)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Answer 404 to probes for well-known admin/blog/login paths without revealing
# anything about this site (the real console lives at a private URL).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "^(admin|administrator|dashboard|wp-admin|wp-login|wp-content|wordpress|joomla|cpanel|plesk|phpmyadmin|pma|login(\.php)?|signin|install|installer|setup)(/.*)?$" - [R=404,L]
</IfModule>

# App/status/policy data edited through the admin console must never be served
# stale: force revalidation so a save is visible on the public site immediately.
<IfModule mod_headers.c>
  <FilesMatch "^(apps|posts|policies|site-config|changelog)\.js$|^main\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
